<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>2.0.1.0</Version>
    <Author>JustPixelll</Author>
    <Name>Should I?</Name>
    <Punchline>Know what to sell, what to buy, and where your gil goes.</Punchline>
    <Description>FFXIV economy intelligence for Dalamud: sell optimization, executable Market Board buy discovery, native live verification, full gil cashflow tracking, FIFO trading P&amp;L, and personal sales/listing analytics.</Description>
    <PackageProjectUrl>https://github.com/JustPixelll/ShouldISell</PackageProjectUrl>
    <RepoUrl>https://github.com/JustPixelll/ShouldISell</RepoUrl>
    <IconUrl>https://raw.githubusercontent.com/JustPixelll/ShouldISell/main/images/icon.png</IconUrl>
    <ImageUrls>https://raw.githubusercontent.com/JustPixelll/ShouldISell/main/images/overview.png;https://raw.githubusercontent.com/JustPixelll/ShouldISell/main/images/details.png</ImageUrls>
    <Tags>market;market board;retainer;sales;trading;arbitrage;profit;portfolio;universalis</Tags>
    <CategoryTags>utility</CategoryTags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>

