<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>2.3.0.0</Version>
    <Author>JustPixelll</Author>
    <Name>Should I?</Name>
    <Punchline>Know what to sell, buy, craft, gather — and what to do next.</Punchline>
    <Description>FFXIV economy decision support for Dalamud. Should I? ranks selling, buying, crafting and gathering opportunities using Universalis, in-game inventory and Market Board observations, vendor economics and your own trading history. Includes native item-tooltip insights, inventory right-click lookups, unified Opportunities, cashflow/FIFO trading analytics and personal sales/listing history. It never automatically buys, sells, reprices or queues native Market Board searches.</Description>
    <PackageProjectUrl>https://github.com/JustPixelll/ShouldISell</PackageProjectUrl>
    <RepoUrl>https://github.com/JustPixelll/ShouldISell</RepoUrl>
    <IconUrl>https://raw.githubusercontent.com/JustPixelll/ShouldISell/main/images/icon.png</IconUrl>
    <ImageUrls>https://raw.githubusercontent.com/JustPixelll/ShouldISell/main/images/overview.png;https://raw.githubusercontent.com/JustPixelll/ShouldISell/main/images/details.png</ImageUrls>
    <Tags>market;market board;retainer;economy;trading;arbitrage;crafting;gathering;universalis;analytics;tooltip</Tags>
    <CategoryTags>utility</CategoryTags>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
